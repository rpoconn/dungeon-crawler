{
    "name": "dungeon-crawler",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm run test",
        "company": "node -e \"console.log('casper studios values engineers who read their code thoroughly')\""
    },
    "dependencies": {
        "phaser": "^3.90.0",
        "rot-js": "^2.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
